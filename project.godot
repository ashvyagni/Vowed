; VOWED — Godot project configuration
;
; Settings here are deliberate. See docs/TECH_STACK.md for the reasoning behind
; the renderer, physics backend and the 60 Hz tick — those three are hard locks,
; not defaults.
;
; Input bindings are generated by tools/generate_input_map.gd, which is the
; source of truth for default bindings. Do not hand-edit the [input] section.

config_version=5

[application]

config/name="Vowed"
config/description="A martial-combat action RPG where an inherited Beast Soul changes the way you fight, in an interconnected world reacting to the legendary beings that threaten it."
config/version="0.1.0-dev"
run/main_scene="res://scenes/lab/CombatLab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[debug]

; Static typing is a project rule (docs/TECH_STACK.md §3.2), so the engine is
; configured to complain about violations rather than rely on discipline alone.
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=0
gdscript/warnings/shadowed_variable=1
gdscript/warnings/integer_division=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

; 60 Hz fixed tick. The combat system's frame data is expressed in these ticks;
; changing this number changes every authored attack in the game.
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
; Tuned for action-game feel and readable air combos, not for realism.
; Air combat timing depends on this value; retune air routes if it changes.
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=true

[layer_names]

; Fixed allocation — see docs/TECH_STACK.md §5.3.
; Never reassign an existing bit; allocate from the reserved range instead.
3d_physics/layer_1="world_static"
3d_physics/layer_2="world_dynamic"
3d_physics/layer_3="player_body"
3d_physics/layer_4="enemy_body"
3d_physics/layer_5="player_hurtbox"
3d_physics/layer_6="enemy_hurtbox"
3d_physics/layer_7="hitbox"
3d_physics/layer_8="projectile"
3d_physics/layer_9="interaction"
3d_physics/layer_10="camera_collide"
3d_physics/layer_11="nav_obstacle"
3d_physics/layer_12="water"
3d_physics/layer_13="reserved_13"
3d_physics/layer_14="reserved_14"
3d_physics/layer_15="reserved_15"
3d_physics/layer_16="reserved_16"

; --------------------------------------------------------------------------
; Autoload order matters. GameEvents has no dependencies; CombatClock emits the
; tick that everything else hangs off, so it must exist before any actor.
; --------------------------------------------------------------------------
[autoload]

GameEvents="*res://src/core/autoload/GameEvents.gd"
CombatClock="*res://src/core/autoload/CombatClock.gd"
CombatDirector="*res://src/core/autoload/CombatDirector.gd"

; --------------------------------------------------------------------------
